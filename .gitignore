# Ignorar archivo de variables de entorno (contraseñas)
.env
# Ignorar carpeta de dependencias de PHP (si usas Composer después)
/vendor/
.clineignore
.clinerules

# Archivos subidos dinámicamente por usuarios
uploads/croquis/*
!uploads/croquis/.gitkeep
!uploads/croquis/index.html
uploads/referencias/*
!uploads/referencias/.gitkeep
!uploads/referencias/index.html
uploads/trabajos/*
!uploads/trabajos/.gitkeep
!uploads/trabajos/index.html
!uploads/trabajos/trabajos.json
!uploads/index.html
!uploads/.htaccess